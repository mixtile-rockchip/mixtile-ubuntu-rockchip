diff --git a/include/otp-key-hash.h b/include/otp-key-hash.h
new file mode 100644
index 0000000..bc121d9
--- /dev/null
+++ b/include/otp-key-hash.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __OTP_KEY_HASH_H
+#define __OTP_KEY_HASH_H
+
+/*
+ * Callback used to program the OTP hash.  The offset is relative to the
+ * start of the OTP hash area.
+ */
+typedef int (*otp_key_hash_write_fn)(void *ctx, int offset,
+				     const unsigned char *data, int len);
+
+/*
+ * Compare the recomputed public-key digest with the key node's stored hash.
+ */
+static inline int otp_key_hash_matches(const unsigned char *digest,
+				       const unsigned char *key_hash, int len)
+{
+	int i;
+
+	if (!digest || !key_hash || len < 0)
+		return 0;
+
+	for (i = 0; i < len; i++) {
+		if (digest[i] != key_hash[i])
+			return 0;
+	}
+
+	return 1;
+}
+
+/*
+ * Validate the current OTP hash and write the missing suffix.
+ *
+ * A valid OTP state is either a full match or a matching prefix followed by
+ * zero bytes.  Every byte after the first zero is checked before any write is
+ * attempted, so a dirty tail is rejected without touching the OTP.
+ *
+ * Returns 0 on success (or when nothing needs to be written), a negative
+ * error from the write callback, or -1 for an invalid OTP state.  On an
+ * invalid state the callback is never invoked.
+ */
+static inline int otp_key_hash_apply(const unsigned char *digest,
+				     const unsigned char *otp, int len,
+				     otp_key_hash_write_fn write_fn,
+				     void *ctx, int *written_size)
+{
+	int prefix = 0;
+	int i;
+
+	if (!digest || !otp || len < 0 || !write_fn || !written_size)
+		return -1;
+
+	while (prefix < len && otp[prefix] == digest[prefix])
+		prefix++;
+
+	for (i = prefix; i < len; i++) {
+		if (otp[i] != 0)
+			return -1;
+	}
+
+	*written_size = prefix;
+	if (prefix == len)
+		return 0;
+
+	return write_fn(ctx, prefix, digest + prefix, len - prefix);
+}
+
+#endif /* __OTP_KEY_HASH_H */
