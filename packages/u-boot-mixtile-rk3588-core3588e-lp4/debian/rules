#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
CROSS_COMPILE ?= $(DEB_HOST_GNU_TYPE)-
endif

ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
NJOBS := -j $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
else
NJOBS := -j $(shell nproc)
endif

include debian/targets.mk

${u-boot-rockchip_platforms}:
	@mkdir -p debian/build/$@

	make O=debian/build/$@ \
	  CROSS_COMPILE=$(CROSS_COMPILE) \
	  ARCH=arm \
	  $(NJOBS) \
	  $@_defconfig

	@touch .scmversion
	@if [ "$(SECURE_BOOT)" = "1" ]; then \
	  cfg=debian/build/$@/.config; \
	  if grep -q '^CONFIG_FIT_SIGNATURE=' $$cfg; then \
	    sed -i 's/^CONFIG_FIT_SIGNATURE=.*/CONFIG_FIT_SIGNATURE=y/' $$cfg; \
	  elif grep -q '^# CONFIG_FIT_SIGNATURE is not set' $$cfg; then \
	    sed -i 's/^# CONFIG_FIT_SIGNATURE is not set/CONFIG_FIT_SIGNATURE=y/' $$cfg; \
	  else \
	    echo 'CONFIG_FIT_SIGNATURE=y' >> $$cfg; \
	  fi; \
	  if grep -q '^CONFIG_SPL_FIT_SIGNATURE=' $$cfg; then \
	    sed -i 's/^CONFIG_SPL_FIT_SIGNATURE=.*/CONFIG_SPL_FIT_SIGNATURE=y/' $$cfg; \
	  elif grep -q '^# CONFIG_SPL_FIT_SIGNATURE is not set' $$cfg; then \
	    sed -i 's/^# CONFIG_SPL_FIT_SIGNATURE is not set/CONFIG_SPL_FIT_SIGNATURE=y/' $$cfg; \
	  else \
	    echo 'CONFIG_SPL_FIT_SIGNATURE=y' >> $$cfg; \
	  fi; \
	  if grep -q '^CONFIG_USE_BOOTARGS=' $$cfg; then \
	    sed -i 's/^CONFIG_USE_BOOTARGS=.*/CONFIG_USE_BOOTARGS=y/' $$cfg; \
	  else \
	    echo 'CONFIG_USE_BOOTARGS=y' >> $$cfg; \
	  fi; \
	  if grep -q '^CONFIG_BOOTARGS=' $$cfg; then \
	    sed -i 's/^CONFIG_BOOTARGS=.*/CONFIG_BOOTARGS=""/' $$cfg; \
	  else \
	    echo 'CONFIG_BOOTARGS=""' >> $$cfg; \
	  fi; \
	  if grep -q '^CONFIG_ENV_IS_NOWHERE=' $$cfg; then \
	    sed -i 's/^CONFIG_ENV_IS_NOWHERE=.*/CONFIG_ENV_IS_NOWHERE=y/' $$cfg; \
	  else \
	    echo 'CONFIG_ENV_IS_NOWHERE=y' >> $$cfg; \
	  fi; \
	  sed -i 's/CONFIG_BOOTDELAY=.*/CONFIG_BOOTDELAY=0/g' $$cfg; \
	  make O=debian/build/$@ ARCH=arm olddefconfig; \
	  grep -q '^CONFIG_FIT_SIGNATURE=y' $$cfg; \
	  grep -q '^CONFIG_SPL_FIT_SIGNATURE=y' $$cfg; \
	  grep -q '^CONFIG_USE_BOOTARGS=y' $$cfg; \
	  grep -q '^CONFIG_BOOTARGS=""' $$cfg; \
	  grep -q '^CONFIG_ENV_IS_NOWHERE=y' $$cfg; \
	  grep -q '^CONFIG_SPL_ROCKCHIP_SECURE_OTP=y' $$cfg; \
	else \
	  sed -i 's/CONFIG_BOOTDELAY=.*/CONFIG_BOOTDELAY=2/g' debian/build/$@/.config; \
	fi
	@sed -i 's/CONFIG_DISABLE_CONSOLE=y/CONFIG_DISABLE_CONSOLE=n/g' debian/build/$@/.config
	@sed -i 's/CONFIG_LOCALVERSION=""/CONFIG_LOCALVERSION=""/g' debian/build/$@/.config

	@mkdir -p debian/build/$@/arch/arm/mach-rockchip
	@cp arch/arm/mach-rockchip/decode_bl31.py debian/build/$@/arch/arm/mach-rockchip/decode_bl31.py

	@cp debian/rkbin/$($@_bl31) debian/build/$@/bl31.elf

	make O=debian/build/$@ \
	  CROSS_COMPILE=$(CROSS_COMPILE) \
	  SOURCE_DATE_EPOCH=$(shell date +%s) \
	  ARCH=arm \
	  $(NJOBS) \
	  BL31=../../../debian/rkbin/$($@_bl31) \
	  spl/u-boot-spl.bin u-boot.dtb u-boot.itb

	# Build the host image tools explicitly; the firmware targets do not
	# necessarily build fit_check_sign.
	make O=debian/build/$@ CROSS_COMPILE=$(CROSS_COMPILE) ARCH=arm tools

	@set -e; \
	srctree="$(CURDIR)"; \
	build="$(CURDIR)/debian/build/$@"; \
	ddr="$(CURDIR)/debian/rkbin/$($@_ddr)"; \
	[ -f "$$ddr" ] || { echo "Missing DDR blob $$ddr" >&2; exit 1; }; \
	if [ "$(SECURE_BOOT)" = "1" ]; then \
	  keydir="$(SECURE_BOOT_KEY_DIR)"; \
	  rkbin="$(RKBIN_TOOLS_DIR)"; \
	  rkbin_dir="$(RKBIN_DIR)"; \
	  [ -n "$$keydir" ] || { echo "SECURE_BOOT_KEY_DIR is not set" >&2; exit 1; }; \
	  for f in dev.key dev.pubkey dev.crt; do \
	    [ -f "$$keydir/$$f" ] || { echo "Missing $$keydir/$$f" >&2; exit 1; }; \
	  done; \
	  [ -n "$$rkbin" ] && [ -x "$$rkbin/rk_sign_tool" ] || \
	    { echo "RKBIN_TOOLS_DIR has no rk_sign_tool" >&2; exit 1; }; \
	  [ -n "$$rkbin_dir" ] && [ -f "$$rkbin_dir/RKBOOT/RK3588MINIALL.ini" ] || \
	    { echo "RKBIN_DIR does not contain RKBOOT/RK3588MINIALL.ini" >&2; exit 1; }; \
	  if grep -Eq '^[[:space:]]*sign_flag[[:space:]]*=[[:space:]]*0x20' "$$rkbin/setting.ini"; then \
	    echo "ERROR: rk_sign_tool sign_flag=0x20 must not be enabled" >&2; exit 1; \
	  fi; \
	  cd "$$build"; \
	  if fdtget -l u-boot.dtb /signature >/dev/null 2>&1; then fdtput -r u-boot.dtb /signature; fi; \
	  ./tools/mkimage -f u-boot.its -k "$$keydir" -K u-boot.dtb -E -p 0x1000 -r u-boot.itb; \
	  if fdtget -l spl/u-boot-spl.dtb /signature >/dev/null 2>&1; then fdtput -r spl/u-boot-spl.dtb /signature; fi; \
	  ./tools/mkimage -f u-boot.its -k "$$keydir" -K spl/u-boot-spl.dtb -E -p 0x1000 -r u-boot.itb; \
	  ./tools/fit_check_sign -f u-boot.itb -k spl/u-boot-spl.dtb -s; \
	  test "$$(fdtget -t s u-boot.dtb /signature/key-dev required)" = conf; \
	  test "$$(fdtget -t s spl/u-boot-spl.dtb /signature/key-dev required)" = conf; \
	  if fdtget -t x u-boot.dtb /signature/key-dev burn-key-hash >/dev/null 2>&1; then \
	    echo "ERROR: burn-key-hash must not be set in u-boot.dtb" >&2; exit 1; \
	  fi; \
	  fdtput -t x spl/u-boot-spl.dtb /signature/key-dev burn-key-hash 1; \
	  test "$$(fdtget -t x spl/u-boot-spl.dtb /signature/key-dev burn-key-hash)" = 1; \
	  cat spl/u-boot-spl-nodtb.bin spl/u-boot-spl.dtb > spl/u-boot-spl.bin; \
	  ./tools/mkimage -n rk3588 -T rksd -d "$$ddr:spl/u-boot-spl.bin" idbloader.img; \
	  ( cd "$$rkbin" \
	    && ./rk_sign_tool cc --chip 3588 \
	    && ./rk_sign_tool lk --key "$$keydir/dev.key" --pubkey "$$keydir/dev.pubkey" \
	    && ./rk_sign_tool sb --idb "$$build/idbloader.img" \
	    && ./rk_sign_tool vb --idb "$$build/idbloader.img" ); \
	  ( cd "$$rkbin_dir" && \
	    "$$srctree/scripts/spl.sh" --ini "$$rkbin_dir/RKBOOT/RK3588MINIALL.ini" \
	      --spl "$$build/spl/u-boot-spl.bin" ); \
	  loader="$$(find "$$rkbin_dir" -maxdepth 1 -name '*loader*.bin' -type f | head -n1)"; \
	  [ -n "$$loader" ] || { echo "ERROR: USB loader was not generated" >&2; exit 1; }; \
	  ( cd "$$rkbin" \
	    && ./rk_sign_tool sl --loader "$$loader" \
	    && ./rk_sign_tool vl --loader "$$loader" ); \
	  cp -f "$$loader" "$$build/MiniLoaderAll.signed.bin"; \
	else \
	  cd "$$build"; \
	  ./tools/mkimage -n rk3588 -T rksd -d "$$ddr:spl/u-boot-spl.bin" idbloader.img; \
	fi

	@dd if=/dev/zero of=debian/build/$@/rkspi_loader.img bs=1M count=0 seek=16
	@parted -s debian/build/$@/rkspi_loader.img mklabel gpt
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart idbloader 64 7167
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart vnvm 7168 7679
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart reserved_space 7680 8063
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart reserved1 8064 8127
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart uboot_env 8128 8191
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart reserved2 8192 16383
	@parted -s debian/build/$@/rkspi_loader.img unit s mkpart uboot 16384 32734
	@dd if=debian/build/$@/idbloader.img of=debian/build/$@/rkspi_loader.img seek=64 conv=notrunc
	@dd if=debian/build/$@/u-boot.itb of=debian/build/$@/rkspi_loader.img seek=16384 conv=notrunc

build: ${u-boot-rockchip_platforms}

binary-arch: $(addprefix package-,$(filter-out orangepi-5-sata-rk3588s,$(filter-out rock-5a-spi-rk3588s,$(u-boot-rockchip_platforms))))

binary: binary-arch

package-%:
	@rm -rf debian/tmp
	@mkdir -m 755 -p debian/tmp/u-boot/usr/lib/u-boot/
	@mkdir -m 755 -p debian/tmp/u-boot/usr/bin/

	@cp debian/build/$(subst package-,,$@)/u-boot.itb debian/tmp/u-boot/usr/lib/u-boot/u-boot.itb
	@cp debian/build/$(subst package-,,$@)/idbloader.img debian/tmp/u-boot/usr/lib/u-boot/idbloader.img
	@cp debian/build/$(subst package-,,$@)/rkspi_loader.img debian/tmp/u-boot/usr/lib/u-boot/rkspi_loader.img
	@if [ "rock-5a-rk3588s" = "$(subst package-,,$@)" ]; then \
		cp debian/build/rock-5a-spi-rk3588s/rkspi_loader.img debian/tmp/u-boot/usr/lib/u-boot/rkspi_loader.img; \
	fi
	@if [ "orangepi-5-rk3588s" = "$(subst package-,,$@)" ]; then \
		cp debian/build/orangepi-5-sata-rk3588s/rkspi_loader.img debian/tmp/u-boot/usr/lib/u-boot/rkspi_loader_sata.img; \
		cp debian/bin/u-boot-install-sata-mtd debian/tmp/u-boot/usr/bin/u-boot-install-sata-mtd; \
	fi
	@cp debian/bin/u-boot-install debian/tmp/u-boot/usr/bin/u-boot-install
	@cp debian/bin/u-boot-install-mtd debian/tmp/u-boot/usr/bin/u-boot-install-mtd

	@mkdir -m 755 -p "debian/tmp/u-boot/DEBIAN"
	@cp debian/preinst debian/tmp/u-boot/DEBIAN/preinst
	@mkdir -p "debian/tmp/u-boot/usr/share/doc/u-boot"
	@cp debian/copyright "debian/tmp/u-boot/usr/share/doc/u-boot"
	@cp debian/changelog "debian/tmp/u-boot/usr/share/doc/u-boot/changelog.Debian"
	@gzip -9 "debian/tmp/u-boot/usr/share/doc/u-boot/changelog.Debian"
	@sh -c "cd 'debian/tmp/u-boot'; find . -type f ! -path './DEBIAN/*' -printf '%P\0' | xargs -r0 md5sum > DEBIAN/md5sums"
	@chown -R root:root "debian/tmp/u-boot" && chmod -R go-w "debian/tmp/u-boot" && chmod -R a+rX "debian/tmp/u-boot"
	@dpkg-gencontrol -pu-boot-$($(subst package-,,$@)_pkg) -P"debian/tmp/u-boot"
	@dpkg --build "debian/tmp/u-boot" ..

clean:
	@rm -rf debian/*tmp debian/tmp debian/build debian/files
	$(MAKE) clean
